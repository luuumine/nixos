---
import "@/styles/components/badges.css";

type Badge = { href: string; src: string; alt: string };

const badges: Badge[] = [
  { href: "https://poz.pet", src: "/badges/people/poz.gif", alt: "poz" },
  {
    href: "https://pucas01.com",
    src: "/badges/people/pucas01.gif",
    alt: "pucas01",
  },
  { href: "https://melqtx.com", src: "/badges/people/mel.gif", alt: "mel" },
  {
    href: "https://wasdhjkl.xyz",
    src: "/badges/people/uiop1.gif",
    alt: "uiop",
  },
];
---

<div class="badges-grid">
  {
    badges.map((badge) => (
      <a href={badge.href} target="_blank" rel="noopener" title={badge.alt}>
        <img src={badge.src} alt={badge.alt} width={88} height={31} />
      </a>
    ))
  }
</div>
