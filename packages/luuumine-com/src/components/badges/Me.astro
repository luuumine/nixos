---
const badgeCode = `<a href="https://luuumine.com"><img src="https://luuumine.com/badges/luuumine.gif" alt="luuumine" /></a>`;
---

<div class="badge-share-container">
  <p>add my badge to your website!</p>

  <div class="badge-share-row">
    <a href="https://luuumine.com">
      <img src="/badges/luuumine.gif" alt="luuumine" width={88} height={31} />
    </a>

    <input
      type="text"
      readonly
      class="copy-box"
      value={badgeCode}
      onclick="this.select()"
    />
  </div>
</div>
