---
import "@/styles/components/notesLog.css";
---

<section class="notes-box">
  <div class="notes-header">
    <h2>logs</h2>
    <span class="notes-meta">api.luuumine.com/notes</span>
  </div>
  <ul id="notes-container" class="notes-container">
    <li class="loading-text">fetching latest notes...</li>
  </ul>
</section>

<script>
  type Note = { id: number; content: string; created_at: string };

  const CACHE_TTL = 1000 * 60;
  const API_URL = "https://api.luuumine.com";
  const NOTES_LIMIT = 10;

  function formatDate(isoString: string) {
    const date = new Date(isoString);

    const yyyy = date.getFullYear();
    const mm = String(date.getMonth() + 1).padStart(2, "0");
    const dd = String(date.getDate()).padStart(2, "0");
    const hh = String(date.getHours()).padStart(2, "0");
    const min = String(date.getMinutes()).padStart(2, "0");

    return `${yyyy}-${mm}-${dd} ${hh}:${min}`;
  }

  function renderNotes(data: Note[] | null) {
    const container = document.getElementById("notes-container");
    if (!container) return;

    if (!data) {
      container.innerHTML = '<li class="loading-text">api error.</li>';
      return;
    }

    if (data.length === 0) {
      container.innerHTML = '<li class="loading-text">no notes found.</li>';
      return;
    }

    container.innerHTML = data
      .map(
        (note) =>
          `<li class="note-entry"><time class="note-time" datetime="${note.created_at}">${formatDate(note.created_at)}</time> <span class="note-content">${note.content}</span></li>`,
      )
      .join("");
  }

  async function fetchNotes(): Promise<Note[] | null> {
    try {
      const res = await fetch(`${API_URL}/notes?limit=${NOTES_LIMIT}`);
      if (!res.ok) throw new Error("Bad API response");
      return (await res.json()) as Note[];
    } catch (error) {
      return null;
    }
  }

  async function sync() {
    const data = await fetchNotes();
    if (data) {
      sessionStorage.setItem("notes_data", JSON.stringify(data));
      sessionStorage.setItem(
        "notes_expires",
        (Date.now() + CACHE_TTL).toString(),
      );
    }
    renderNotes(data);
  }

  function init() {
    const cachedData = sessionStorage.getItem("notes_data");
    const cachedExp = sessionStorage.getItem("notes_expires");

    if (cachedData && cachedExp && Date.now() < parseInt(cachedExp, 10)) {
      renderNotes(JSON.parse(cachedData));
    } else {
      sync();
    }

    if (!window._notesInterval) {
      window._notesInterval = window.setInterval(sync, CACHE_TTL);
    }
  }

  declare global {
    interface Window {
      _notesInterval: number;
    }
  }

  document.addEventListener("astro:page-load", init);
</script>
