---
import Base from "@/layouts/Base.astro";
import NotesLog from "@/components/NotesLog.astro";

const pageTitle = "home";
---

<Base title={pageTitle}>
  <h1>lumine</h1>
  <p>hi i'm <strong>lumine</strong>!</p>
  <p>
    i'm a data scientist in france and i like tinkering with code and
    self-hosting.
  </p>
  <p>
    i care pretty strongly about <strong>privacy</strong> and <strong
      >open-source</strong
    >.
  </p>
  <p>
    you can find this site's source code in <a
      href="https://git.luuumine.com/luuumine/nixos"
      target="_blank"
      rel="noopener">
      my monorepo
    </a> at <a
      href="https://git.luuumine.com/luuumine/nixos/src/branch/main/packages/luuumine-com"
      target="_blank"
      rel="noopener">packages/luuumine-com</a
    >.
  </p>
  <NotesLog />
</Base>
